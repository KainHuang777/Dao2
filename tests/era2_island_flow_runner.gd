extends SceneTree
const Flow = preload("res://src/presentation/island_flow_model.gd")
var checks := 0
var failures: Array[String] = []
func _init() -> void: _run.call_deferred()
func check(ok: bool, label: String) -> void:
	checks += 1
	if not ok: failures.append(label)
func frames() -> void:
	for n in 8: await process_frame
func _run() -> void:
	root.size=Vector2i(1280,720)
	root.content_scale_size=root.size
	var script = load("res://src/abode/living_abode.gd")
	script.save_dir_override = RunnerResult.output_path("res://era2-flow-save")
	SaveSlots.new(FileStorageAdapter.new(script.save_dir_override)).reset()
	var abode = load("res://scenes/living_abode.tscn").instantiate()
	root.add_child(abode)
	while abode.feature_navigation == null: await process_frame
	await frames()
	abode.set_process(false)
	abode.offline_summary.hide()
	abode.v2_rules_notice.hide()
	var nav = abode.feature_navigation
	var decoded := SaveCodec.decode(FileAccess.get_file_as_string("res://docs/verification/artifacts/res1-c-earned-era2.json"))
	check(decoded.ok,"earned Era2 fixture")
	abode.session.state = decoded.state.duplicate_state()
	var now := str(int(Time.get_unix_time_from_system()*1000))
	var fixture := SaveCodec.encode(abode.session.state,abode.content.content_version,{"save_id":"era2-browser","saved_at_utc_ms":now,"settled_until_utc_ms":now,"sim_tick":str(int(abode.session.state.total_elapsed_seconds))})
	check(SaveCodec.decode(fixture.json).ok,"browser fixture valid before serving")
	var file := FileAccess.open(RunnerResult.output_path("res://era2-browser-start.json"),FileAccess.WRITE)
	file.store_string(fixture.json)
	file.close()
	var view: Dictionary = abode.session.get_view()
	check(not Flow.discovered(view,"manufacturing"),"manufacturing hidden before first opening")
	check(not Flow.discovered(view,"transport"),"transport hidden before endpoints")
	nav.open("outposts")
	await frames()
	var panel = nav.island_flow
	check(panel.visible and not nav.island_panel.visible,"focused default")
	check(not nav.tab_buttons.manufacturing.visible,"staged navigation")
	var before := JSON.stringify(abode.session.state.to_snapshot_dict())
	panel.refresh(abode.session.get_view(),abode.content.processing_catalog)
	check(before == JSON.stringify(abode.session.state.to_snapshot_dict()),"guide refresh read only")
	var emissions: Array = []
	panel.action_requested.connect(func(kind: String,payload: Dictionary): emissions.append([kind,payload]))
	check(not panel.buttons[0].disabled,"earned opening affordable")
	panel.buttons[0].pressed.emit()
	await frames()
	check(not emissions.is_empty() and emissions[-1][0]=="open_island","opening sends canonical command")
	check(Flow.opened(abode.session.get_view(),"wood"),"opening committed")
	check(nav.tab_buttons.manufacturing.visible,"manufacturing revealed")
	panel.buttons[0].pressed.emit()
	await frames()
	check(nav.page=="manufacturing","next action leads manufacturing")
	check(panel._actions[0].get("page")=="outposts" and panel._actions[0].get("id")=="ore","local shortage leads source opening")
	panel.buttons[0].pressed.emit()
	await frames()
	panel.buttons[0].pressed.emit()
	await frames()
	check(Flow.opened(abode.session.get_view(),"ore"),"second source opened")
	check(nav.tab_buttons.transport.visible,"transport revealed with two endpoints")
	check(panel._actions[0].get("id")=="spirit_timber","opening source resumes interrupted recipe")
	nav._flow_navigate("manufacturing","spirit_timber")
	await frames()
	check(panel._actions[0].get("page")=="transport","shortage routes to inbound supply")
	panel.buttons[0].pressed.emit()
	await frames()
	check(panel.route=="ore_wood","exact missing-material route")
	var settings: Dictionary = abode.session.get_view().transport.ore_wood.settings.duplicate(true)
	panel.buttons[0].pressed.emit()
	await frames()
	var updated: Dictionary = abode.session.get_view().transport.ore_wood.settings
	check(updated.enabled and updated.target==settings.target and updated.reserve==settings.reserve and updated.level==settings.level,"toggle preserves saved policy")
	abode.session.advance_time(40)
	abode._refresh_hud()
	nav._flow_navigate("manufacturing","spirit_timber")
	await frames()
	check(panel._actions[0].get("kind")=="craft","arrived resources enable craft")
	panel.buttons[0].pressed.emit()
	await frames()
	check(abode.session.state.economy.jobs.has("wood"),"craft on existing Session")
	abode.session.advance_time(15)
	abode._refresh_hud()
	await frames()
	check(float(abode.session.get_view().economy.inventory.wood.spirit_timber.available)>0,"production settles actual output")
	panel.buttons[1].pressed.emit()
	await frames()
	check(panel.route=="timber_home","product return route exact")
	panel.buttons[0].pressed.emit()
	abode.session.advance_time(20)
	abode._refresh_hud()
	await frames()
	check(float(abode.session.get_view().economy.inventory.home.spirit_timber.available)>0,"product delivered home")
	var saved := SaveCodec.encode(abode.session.state,abode.content.content_version,{"save_id":"flow","saved_at_utc_ms":"0","settled_until_utc_ms":"0","sim_tick":"0"})
	check(saved.ok,"flow state encodes")
	var reload := SaveCodec.decode(saved.json)
	check(reload.ok,"flow state reloads")
	abode.session.state=reload.state
	nav.home()
	nav.open("transport")
	await frames()
	check(panel.route=="timber_home" and panel.visible,"repeat use keeps task selection")
	panel.full_requested.emit()
	await frames()
	check(nav.transport_panel.visible and not panel.visible and nav.flow_return.visible,"full settings reachable")
	nav.flow_return.pressed.emit()
	await frames()
	check(panel.visible and not nav.transport_panel.visible,"return to focused mode")
	root.content_scale_mode=Window.CONTENT_SCALE_MODE_DISABLED
	for vp in ([Vector2i(1280,720),Vector2i(844,390),Vector2i(800,360)] if OS.get_environment("DAO_VIEWPORT_MATRIX")=="full" else [Vector2i(1280,720)]):
		root.size=vp
		root.content_scale_size=vp
		for route in ["outposts","manufacturing","transport"]:
			nav.open(route)
			abode._layout_for_size(Vector2(vp))
			await frames()
			check(nav.shell.workbench.pages.get_global_rect().encloses(panel.get_global_rect()),"panel inside allocated workspace "+route+str(vp))
			for button in panel.buttons:
				if button.is_visible_in_tree(): check(panel.get_global_rect().encloses(button.get_global_rect()),"primary actions fit "+route+str(vp))
			check(panel.column.get_combined_minimum_size().y<=panel.size.y,"no vertical scrolling "+route+str(vp))
			if DisplayServer.get_name()!="headless":
				await RenderingServer.frame_post_draw
				root.get_texture().get_image().save_png(RunnerResult.output_path("res://era2-flow/%s-%dx%d.png"%[route,vp.x,vp.y]))
	panel.show_result("操作未保存：test")
	check(panel.retry.visible,"save failure offers save-only retry")
	panel.storage_recovered()
	check(not panel.retry.visible,"retry recovery clears failure")
	abode.queue_free()
	await process_frame
	print("ERA2-FLOW checks=%d failures=%s"%[checks,JSON.stringify(failures)])
	RunnerResult.finish(self,0 if failures.is_empty() else 1)
