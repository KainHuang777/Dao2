extends SceneTree
const Policy = preload("res://src/presentation/ui_shell_policy.gd")
const ShellState = preload("res://src/presentation/ui_shell_state.gd")
const Navigation = preload("res://src/presentation/feature_navigation.gd")
var checks := 0
var failures: Array[String] = []

func check(ok: bool, message: String) -> void:
	checks += 1
	if not ok:
		failures.append(message)
		push_error(message)

func _init() -> void:
	var view := {"era_id": 3, "reincarnation_count": 1, "buildings": {"library": {"level": 1}}, "fortune": {"has_pending": true, "pending_encounter": {"id": "unchanged"}}}
	var original_view := view.duplicate(true)
	var shell := ShellState.new()
	shell.set_home_preferences(0, false)
	var prefs: Dictionary = shell.snapshot().home_preferences
	check(Navigation.GROUPS == Policy.GROUPS, "runtime navigation shares canonical registry")
	var route_count := 0
	for group in Policy.GROUPS:
		for entry in Policy.GROUPS[group].pages:
			route_count += 1
			var route: String = entry[0]
			check(Policy.owner(route) == group, "canonical owner " + route)
			check(shell.navigate(route, view), "enter " + route)
			var before := shell.snapshot()
			for vp in ([Vector2(1280, 720), Vector2(844, 390), Vector2(800, 360), Vector2(360, 640)] if OS.get_environment("DAO_VIEWPORT_MATRIX") == "full" else [Vector2(1280, 720)]):
				var layout := Policy.resolve(shell.snapshot(), vp, {"has_costs": true, "save_failed": true})
				check(layout == Policy.resolve(before, vp, {"has_costs": true, "save_failed": true}), "deterministic resize " + route)
				check(layout.critical_alert and not layout.world_input, "save error survives every feature/size " + route)
				check(layout.hud == ("hidden" if vp.x < vp.y else "compact"), "consistent feature HUD " + route)
			check(shell.snapshot() == before, "resize never mutates intent " + route)
			check(shell.snapshot().home_preferences == prefs, "navigation keeps home preferences " + route)
	check(route_count == 13, "all13 current routes registered")
	check(Policy.resolve(shell.snapshot(), Vector2(1280, 390)).layout == "compact", "height pressure overrides width")
	check(Policy.resolve(shell.snapshot(), Vector2(960, 600)).layout == "wide", "docs07 shared width threshold")
	for route in Policy.INVENTORY_ROUTES:
		shell.navigate(route, view)
		check(Policy.resolve(shell.snapshot(), Vector2(1280, 720)).resource_presentation == "rail", "inventory automatic rail " + route)
		check(Policy.resolve(shell.snapshot(), Vector2(800, 360)).resource_presentation == "summary", "compact inventory summary " + route)
	shell.navigate("manufacturing", view)
	shell.collapse_resources(true)
	for i in 5:
		shell.navigate("manufacturing", view)
		check(Policy.resolve(shell.snapshot(), Vector2(1280, 720)).resource_presentation == "hidden", "refresh cannot reopen collapsed rail")
	shell.navigate("transport", view)
	check(not shell.snapshot().resources_collapsed, "different route clears page override")
	shell.navigate("sect", view, "market")
	check(Policy.resolve(shell.snapshot(), Vector2(1280, 720)).resource_context == "inventory", "sect market inventory")
	shell.collapse_resources(true)
	shell.set_confirmation(true)
	shell.set_detail(true)
	shell.navigate("sect", view, "techniques")
	check(shell.snapshot().resources_collapsed, "subpage switch does not force reopen")
	check(not shell.snapshot().confirmation and not shell.snapshot().detail, "subpage switch discards stale submission/detail")
	shell.navigate("reincarnation", view, "life")
	check(Policy.resolve(shell.snapshot(), Vector2(800, 360)).resource_context == "none", "life reading has no live stock")
	shell.navigate("reincarnation", view, "talents")
	check(Policy.resolve(shell.snapshot(), Vector2(800, 360)).resource_context == "focused", "talent dao heart context")
	shell.navigate("fortune", view)
	check(Policy.resolve(shell.snapshot(), Vector2(800, 360)).resource_context == "none", "costless event no empty stock panel")
	check(Policy.resolve(shell.snapshot(), Vector2(800, 360), {"has_costs": true}).resource_context == "focused", "costed event focused resources")
	shell.set_detail(true)
	shell.set_confirmation(true)
	check(not Policy.resolve(shell.snapshot(), Vector2(800, 360)).page_input and Policy.resolve(shell.snapshot(), Vector2(800, 360)).confirmation_input, "confirmation owns page input")
	var reading := shell.open_overlay("messages")
	check(reading > 0 and not shell.navigate("buildings", view), "reading blocks background navigation")
	check(Policy.resolve(shell.snapshot(), Vector2(800, 360)).messages == "reading", "explicit message reading")
	check(shell.escape(view) == "overlay" and shell.snapshot().route == "fortune", "reading closes to exact route")
	check(shell.escape(view) == "confirmation", "Escape cancels confirmation before detail")
	check(shell.escape(view) == "detail", "Escape then returns to list")
	check(shell.escape(view) == "home", "Escape then returns home")
	shell.navigate("reincarnation", view, "talents")
	var return_tool := shell.open_overlay("tool")
	check(shell.finish_overlay(return_tool, view) and shell.snapshot().subpage == "talents", "tool retains legal route and subpage")
	shell.navigate("home", view)
	var home := Policy.resolve(shell.snapshot(), Vector2(1280, 720))
	check(home.resource_presentation == "hidden" and home.messages == "hidden" and home.world_input, "home preferences restored")
	shell.set_home_preferences(2, true)
	check(Policy.resolve(shell.snapshot(), Vector2(1280, 720)).messages == "home", "explicit home preference takes effect")
	shell.navigate("skills", view)
	check(Policy.resolve(shell.snapshot(), Vector2(1280, 720)).messages == "hidden", "feature temporarily hides home messages")
	var drawer := shell.open_overlay("resources")
	check(Policy.resolve(shell.snapshot(), Vector2(800, 360)).resource_presentation == "drawer", "short resource drawer")
	var tool := shell.open_overlay("tool")
	check(not shell.finish_overlay(drawer, view), "replaced drawer callback ignored")
	var sequence := shell.open_overlay("sequence")
	check(shell.open_overlay("messages") == 0 and shell.escape(view) == "blocked", "sequence cannot be stolen or escaped")
	check(Policy.resolve(shell.snapshot(), Vector2(800, 360)).hud == "hidden", "sequence hides normal HUD")
	var protection := shell.open_overlay("protection")
	check(not shell.finish_overlay(sequence, view) and not shell.finish_overlay(tool, view), "stale callbacks cannot unlock protection")
	check(shell.escape(view) == "blocked" and shell.open_overlay("tool") == 0, "save protection not bypassed")
	check(Policy.resolve(shell.snapshot(), Vector2(800, 360), {"save_failed": true}).critical_alert, "protection carries critical alert")
	check(shell.finish_overlay(protection, view) and shell.snapshot().route == "skills", "explicit protection finish restores legal route")
	shell.navigate("manufacturing", view)
	var pending_tool := shell.open_overlay("tool")
	check(shell.finish_overlay(pending_tool, {"era_id": 1}) and shell.snapshot().route == "buildings", "reincarnation invalidates former island route")
	shell.navigate("beasts", view)
	shell.set_confirmation(true)
	shell.revalidate({"era_id": 1})
	check(shell.snapshot().route == "alchemy" and not shell.snapshot().confirmation, "hidden cultivation route cancels stale confirmation")
	shell.navigate("fortune", {"era_id": 1})
	check(shell.snapshot().route == "fortune", "preview remains readable, eligibility stays in Session")
	shell.navigate("unknown", view)
	check(shell.snapshot().route == "home", "unknown route safe fallback")
	var copy := shell.snapshot()
	copy.home_preferences.resource_mode = 0
	check(shell.snapshot().home_preferences.resource_mode == 2, "snapshot cannot mutate preferences")
	check(view == original_view, "all transitions/reading leave caller View and pending event untouched")
	check(ShellState.new().snapshot().route == "home", "reload starts home without UI save schema")
	var home_state := {"route": "home", "home_preferences": {"messages_open": true}}
	check(Policy.resolve(home_state, Vector2(800,360), {"home_message_obstructs": true}).messages == "hidden", "automatic message yields to starter landmark without changing preference")
	check(Policy.resolve(home_state, Vector2(800,360)).messages == "home" and home_state.home_preferences.messages_open, "clear obstruction restores preferred message")
	print("UI-SHELL-0: checks=", checks, " failures=", JSON.stringify(failures))
	RunnerResult.finish(self, 0 if failures.is_empty() else 1)
