; Isolated M0-A persistence probe. It has a distinct project name and Web origin.
config_version=5

[application]
config/name="修仙問道 v2 — 周天持久化探針"
run/main_scene="res://scenes/cycle_probe.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display/window]
size/viewport_width=720
size/viewport_height=1280
size/window_width_override=360
size/window_height_override=640
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
