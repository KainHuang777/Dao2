extends SceneTree
## Early-game pacing audit (report mode). Does not change any game value.
## Run: godot --headless --path . --script res://tools/early_pacing_audit.gd [-- --enforce]
## Writes docs/verification/early-pacing-baseline.md and .json.
## Formulas: src/utils/pacing_metrics.gd; thresholds: tools/early_pacing_targets.json;
## strategies: src/utils/pacing_sim.gd. Rates/costs/caps come from the real rules.

const Metrics = preload("res://src/utils/pacing_metrics.gd")
const Sim = preload("res://src/utils/pacing_sim.gd")
const OUT_MD := "res://docs/verification/early-pacing-baseline.md"
const OUT_JSON := "res://docs/verification/early-pacing-baseline.json"
const LEVEL_CAP := 10

var targets: Dictionary
var thresholds: Dictionary
var assumptions: Dictionary
var md: PackedStringArray = []
var findings: Array = []
var summary := {}

func _init() -> void:
	call_deferred("_run")

func _run() -> void:
	targets = JSON.parse_string(FileAccess.get_file_as_string("res://tools/early_pacing_targets.json"))
	thresholds = targets.thresholds
	assumptions = targets.assumptions
	var base := ContentLoader.load_directory("res://content")
	if not bool(base.ok):
		push_error("content failed: %s" % str(base.errors))
		quit(2)
		return
	var content: GameContent = base.content
	var attached: Dictionary = IslandProgression.attach_supply(content)
	var supply_ok := bool(attached.get("ok", false))
	md.append("# Early pacing baseline (auto-generated)")
	md.append("")
	md.append("Generated by `tools/early_pacing_audit.gd`. Report mode: no game value is changed. Thresholds: `tools/early_pacing_targets.json`.")
	md.append("")
	md.append("Supply content (`res1-e-46-1`, Era 4–6, deep/ancient/void islands): %s." % ("attached" if supply_ok else "FAILED — " + str(attached)))
	md.append("")
	_era_chain(content)
	_era1_static(content)
	_era1_coupling(content)
	_era1_simulation(content)
	_islands(content)
	if supply_ok:
		_supply_chain(content)
	else:
		_finding("C11", "WARN", "supply content did not attach: %s" % str(attached))
	_write_findings()
	_save()
	var enforce := "--enforce" in OS.get_cmdline_user_args()
	var failing := 0
	for f in findings:
		if f.severity == "FAIL":
			failing += 1
	print("PACING AUDIT: %d findings, %d FAIL (see %s)" % [findings.size(), failing, OUT_MD])
	quit(1 if enforce and failing > 0 else 0)

func _f(a: Variant) -> float:
	return (a as AmountCompat).to_float()

func _finding(id: String, severity: String, text: String) -> void:
	findings.append({"id": id, "severity": severity, "text": text})

# ---------------------------------------------------------------- era chain
func _era_chain(content: GameContent) -> void:
	md.append("## 1. Cultivation clock (wall-clock gate)")
	md.append("")
	md.append("| Era | max level | base s | mult | total training s | total min | level-up cost | breakthrough capacity |")
	md.append("| --- | --- | --- | --- | --- | --- | --- | --- |")
	var chains := {}
	var era_ids: Array = content.era_ids.duplicate()
	if era_ids.is_empty():
		era_ids = [1, 2, 3, 4, 5, 6]
	era_ids.sort()
	for era_id in era_ids:
		var def: Variant = content.era(era_id)
		if def == null:
			var raw: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://content/eras/era%d.json" % era_id))
			def = raw[0] if raw is Array and not raw.is_empty() else null
		if def == null:
			continue
		var req: Dictionary = def.level_up_requirements
		var total := Metrics.chain_training_seconds(float(req.base_time), float(req.time_multiplier), int(def.max_level))
		chains[era_id] = total
		md.append("| %d | %d | %s | %s | %s | %.1f | %s | %s |" % [era_id, int(def.max_level), str(req.base_time), str(req.time_multiplier), Metrics.fmt(total), total / 60.0, str(req.resources), str(def.upgrade_requirements.capacity)])
	md.append("")
	summary["chain_training_seconds"] = chains

# ---------------------------------------------------------------- static Era 1
func _ref_buildings(content: GameContent) -> Dictionary:
	var ref := {}
	for id in content.building_ids:
		ref[id] = 0
	for id in assumptions.reference_chain:
		ref[id] = int(assumptions.reference_chain[id])
	return ref

func _produced_keys(def: Dictionary) -> Array:
	var keys: Array = []
	for k in def.effects:
		if not String(k).ends_with("_max") and String(k) != "synthetic_max_mult":
			keys.append(String(k))
	return keys

func _era1_static(content: GameContent) -> void:
	md.append("## 2. Era 1 per-step table (reference state = onboarding chain done)")
	md.append("")
	md.append("Rates, caps and costs come from `Production` / `BuildingCosts`. Columns: `afford` = seconds to pay the worst cost resource from empty at reference rates; `pressure` = min over cost resources of cap/cost; `ratio` = afford / fill time of that resource; `gain` = relative rate gain of the next level; `delay@300` = production lost if the purchase is made 300 s late; `ovf@300` = fraction of production discarded if the store is emptied every 300 s.")
	md.append("")
	var ref := _ref_buildings(content)
	var rates_ref := Production.compute_rates(content, ref, 1.0)
	var caps_ref := Production.compute_caps(content, ref, 1, 1)
	var n_levels := mini(int(assumptions.static_levels_per_building), LEVEL_CAP)
	var c1: Array = []
	var c2: Array = []
	var c3: Array = []
	var c4: Array = []
	var c5: Array = []
	var c6: Array = []
	var total_rows := 0
	for id in content.building_ids:
		var def: Dictionary = content.buildings[id]
		if int(def.era) != 1:
			continue
		var produced := _produced_keys(def)
		md.append("### %s (%s)" % [id, "rate: " + ",".join(produced) if not produced.is_empty() else "capacity only"])
		md.append("")
		md.append("| L→L+1 | cost | afford s | pressure | ratio | gain | delay@300 | ovf@300 |")
		md.append("| --- | --- | --- | --- | --- | --- | --- | --- |")
		for level in range(0, mini(n_levels, int(def.max_level))):
			total_rows += 1
			var costs := BuildingCosts.compute_cost(BuildingCosts.resolve_base_cost(id, def.base_cost, true), level, float(def.cost_factor))
			var worst_afford := 0.0
			var min_pressure := Metrics.INF_SECONDS
			var worst_ratio := 0.0
			var cost_text: PackedStringArray = []
			for rid in costs:
				var cost := _f(costs[rid])
				cost_text.append("%s %s" % [rid, Metrics.fmt(cost)])
				var rate := _f(rates_ref[rid])
				var cap := _f(caps_ref[rid])
				var afford := Metrics.afford_seconds(cost, 0.0, rate)
				var pressure := Metrics.cap_pressure(cap, cost)
				var fill := Metrics.fill_seconds(cap, rate)
				worst_afford = maxf(worst_afford, afford)
				min_pressure = minf(min_pressure, pressure)
				if fill > 0.0:
					worst_ratio = maxf(worst_ratio, afford / fill)
			var gain_text := "-"
			var delay_text := "-"
			var ovf_text := "-"
			if not produced.is_empty():
				var b0 := ref.duplicate()
				b0[id] = level
				var b1 := ref.duplicate()
				b1[id] = level + 1
				var r0 := Production.compute_rates(content, b0, 1.0)
				var r1 := Production.compute_rates(content, b1, 1.0)
				var d_total := 0.0
				var base_total := 0.0
				for key in produced:
					if r0.has(key):
						d_total += _f(r1[key]) - _f(r0[key])
						base_total += _f(r0[key])
				var gain := Metrics.gain_ratio(base_total, base_total + d_total)
				gain_text = "%.0f%%" % (gain * 100.0)
				delay_text = Metrics.fmt(Metrics.delay_loss(d_total, 300.0))
				var first: String = produced[0]
				if r1.has(first):
					var ovf := Metrics.overflow_ratio(_f(caps_ref[first]), _f(r1[first]), 300.0)
					ovf_text = "%.0f%%" % (ovf * 100.0)
					if not Metrics.in_band(ovf, float(thresholds.C6_overflow_low), float(thresholds.C6_overflow_high)):
						c6.append("%s L%d (%s %.0f%%)" % [id, level, first, ovf * 100.0])
				if level < int(thresholds.C5_levels_checked) and gain < float(thresholds.C5_min_gain_first_levels):
					c5.append("%s L%d (%.0f%%)" % [id, level, gain * 100.0])
			if min_pressure < 1.0:
				c1.append("%s L%d" % [id, level])
			if not Metrics.in_band(min_pressure, float(thresholds.C2_pressure_low), float(thresholds.C2_pressure_high)):
				c2.append("%s L%d (%s)" % [id, level, Metrics.fmt(min_pressure)])
			if not Metrics.in_band(worst_afford, float(thresholds.C3_afford_low_seconds), float(thresholds.C3_afford_high_seconds)):
				c3.append("%s L%d (%ss)" % [id, level, Metrics.fmt(worst_afford)])
			if not Metrics.in_band(worst_ratio, float(thresholds.C4_afford_fill_low), float(thresholds.C4_afford_fill_high)):
				c4.append("%s L%d (%s)" % [id, level, Metrics.fmt(worst_ratio)])
			md.append("| %d→%d | %s | %s | %s | %s | %s | %s | %s |" % [level, level + 1, ", ".join(cost_text), Metrics.fmt(worst_afford), Metrics.fmt(min_pressure), Metrics.fmt(worst_ratio), gain_text, delay_text, ovf_text])
		md.append("")
	_check("C1", "deadlock: cap < next cost", c1, total_rows, "FAIL")
	_check("C2", "capacity pressure out of band [%s, %s]" % [str(thresholds.C2_pressure_low), str(thresholds.C2_pressure_high)], c2, total_rows, "WARN")
	_check("C3", "afford time out of [%ss, %ss]" % [str(thresholds.C3_afford_low_seconds), str(thresholds.C3_afford_high_seconds)], c3, total_rows, "WARN")
	_check("C4", "afford/fill ratio out of [%s, %s]" % [str(thresholds.C4_afford_fill_low), str(thresholds.C4_afford_fill_high)], c4, total_rows, "WARN")
	_check("C5", "rate gain below %.0f%% in first %d levels" % [float(thresholds.C5_min_gain_first_levels) * 100.0, int(thresholds.C5_levels_checked)], c5, total_rows, "WARN")
	_check("C6", "5-minute idle overflow out of [%.0f%%, %.0f%%]" % [float(thresholds.C6_overflow_low) * 100.0, float(thresholds.C6_overflow_high) * 100.0], c6, total_rows, "WARN")

func _check(id: String, label: String, hits: Array, rows: int, severity: String) -> void:
	summary[id] = {"violations": hits.size(), "rows": rows}
	if hits.is_empty():
		_finding(id, "OK", "%s: none (%d rows)" % [label, rows])
		return
	var sample := hits.slice(0, 8)
	_finding(id, severity, "%s: %d/%d rows. e.g. %s%s" % [label, hits.size(), rows, ", ".join(sample), " ..." if hits.size() > 8 else ""])

# ---------------------------------------------------------------- coupling
func _era1_coupling(content: GameContent) -> void:
	md.append("## 3. Gate coupling (C8)")
	md.append("")
	var gate := {}
	for era_id in [1, 2]:
		var def: Dictionary = content.era(era_id)
		for rid in def.level_up_requirements.resources:
			gate[String(rid)] = true
		for rid in def.upgrade_requirements.capacity:
			gate[String(rid)] = true
	md.append("Gate resources (level-up cost and breakthrough capacity, Era 1–2): %s" % ", ".join(gate.keys()))
	md.append("")
	var required := {}
	for id in assumptions.reference_chain:
		required[id] = int(assumptions.reference_chain[id])
	var hard := {}
	for id in content.building_ids:
		var def: Dictionary = content.buildings[id]
		if int(def.era) != 1:
			continue
		for key in def.effects:
			var target := String(key).trim_suffix("_max")
			if gate.has(target):
				hard[id] = true
	var changed := true
	while changed:
		changed = false
		for id in hard.keys():
			var prereq: Variant = content.buildings[id].prereq
			if prereq != null and not hard.has(String(prereq.building)):
				hard[String(prereq.building)] = true
				changed = true
	md.append("| building | required lvl | level cap | headroom | gate-coupled |")
	md.append("| --- | --- | --- | --- | --- |")
	var headroom_total := 0
	var headroom_free := 0
	var orphans: Array = []
	for id in content.building_ids:
		var def: Dictionary = content.buildings[id]
		if int(def.era) != 1:
			continue
		var cap := mini(int(def.max_level), LEVEL_CAP)
		var req: int = int(required.get(id, 0))
		var headroom := maxi(0, cap - req)
		# A coupled building still has no gate effect once its gate-producing levels are maxed.
		var gate_effect := false
		for key in def.effects:
			if gate.has(String(key).trim_suffix("_max")):
				gate_effect = true
		var useful_headroom := headroom if gate_effect else 0
		headroom_total += headroom
		headroom_free += headroom - useful_headroom
		if not gate_effect:
			orphans.append(id)
		md.append("| %s | %d | %d | %d | %s |" % [id, req, cap, headroom, "direct" if gate_effect else ("prereq only" if hard.has(id) else "NONE")])
	md.append("")
	var share := float(headroom_free) / float(maxi(1, headroom_total))
	md.append("Headroom levels beyond the onboarding chain: %d, of which %d (%.0f%%) do not raise any gate resource rate or capacity." % [headroom_total, headroom_free, share * 100.0])
	md.append("")
	summary["C8"] = {"headroom_total": headroom_total, "headroom_free": headroom_free, "share": share}
	var sev := "WARN" if share > 0.5 else "OK"
	_finding("C8", sev, "gate-irrelevant headroom share %.0f%% (%d/%d levels); buildings without a direct gate effect: %s" % [share * 100.0, headroom_free, headroom_total, ", ".join(orphans)])

# ---------------------------------------------------------------- simulation
func _era1_simulation(content: GameContent) -> void:
	md.append("## 4. Active vs idle simulation (real GameSession, Era 1)")
	md.append("")
	md.append("Assumptions: active = %d clicks/s, acts every second; idle = returns every %d s, %d clicks per visit, buys greedily. Score horizon %d s. Pills (聚靈丹) are only used after the onboarding chain." % [int(assumptions.active_clicks_per_second), int(assumptions.idle_visit_interval_seconds), int(assumptions.idle_visit_clicks), int(assumptions.score_horizon_seconds)])
	md.append("")
	var params := {
		"max_seconds": int(assumptions.sim_max_seconds), "horizon": int(assumptions.score_horizon_seconds),
		"clicks_per_second": int(assumptions.active_clicks_per_second),
		"interval": int(assumptions.idle_visit_interval_seconds), "visit_clicks": int(assumptions.idle_visit_clicks),
		"use_pills": false,
	}
	var runs := {}
	for pills in [false, true]:
		for mode in ["active", "idle"]:
			var p := params.duplicate()
			p.use_pills = pills
			var sim = Sim.new(content)
			runs["%s_%s" % [mode, "pills" if pills else "nopills"]] = sim.run(mode, p)
	md.append("| run | chain done s | lv10 s | breakthrough-ready s | bldg levels @H | cult lvl @H | purchases | clicks | pills | stuck |")
	md.append("| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
	for key in runs:
		var r: Dictionary = runs[key]
		md.append("| %s | %s | %s | %s | %d | %d | %d | %d | %d | %s |" % [key, _t(r.t_chain_done), _t(r.t_lv10), _t(r.t_ready), r.levels_at_horizon, r.cult_level_at_horizon, r.purchases, r.clicks, r.pills, str(r.stuck)])
	md.append("")
	md.append("Overflow lost to caps (estimate, units): ")
	md.append("")
	for key in runs:
		md.append("- %s: %s" % [key, str(runs[key].overflow)])
	md.append("")
	summary["sim"] = runs
	var a: Dictionary = runs.active_nopills
	var i: Dictionary = runs.idle_nopills
	var ratio_levels := float(a.levels_at_horizon) / float(maxi(1, i.levels_at_horizon))
	var chain_ratio := 0.0
	if a.t_chain_done > 0.0 and i.t_chain_done > 0.0:
		chain_ratio = i.t_chain_done / a.t_chain_done
	_finding("C7", "OK" if ratio_levels >= float(thresholds.C7_active_over_idle_min) else "WARN", "active/idle building levels @%ds = %.2fx (target >= %.1fx); chain completion idle/active = %.2fx" % [int(assumptions.score_horizon_seconds), ratio_levels, float(thresholds.C7_active_over_idle_min), chain_ratio])
	var end_a := _end(a)
	var end_i := _end(i)
	var share_nopill := Metrics.reducible_share(end_i, end_a)
	var share_pill := Metrics.reducible_share(_end(runs.idle_pills), _end(runs.active_pills))
	summary["C9"] = {"reducible_nopills": share_nopill, "reducible_pills": share_pill}
	var s9 := "OK" if maxf(share_nopill, share_pill) >= float(thresholds.C9_reducible_share_min) else "WARN"
	_finding("C9", s9, "time to breakthrough-ready: idle %.0fs vs active %.0fs without pills (reducible %.0f%%); with pills idle %.0fs vs active %.0fs (reducible %.0f%%); target >= %.0f%%" % [end_i, end_a, share_nopill * 100.0, _end(runs.idle_pills), _end(runs.active_pills), share_pill * 100.0, float(thresholds.C9_reducible_share_min) * 100.0])

func _t(v: float) -> String:
	return "-" if v < 0.0 else "%.0f" % v

func _end(r: Dictionary) -> float:
	return float(r.t_ready) if float(r.t_ready) >= 0.0 else float(r.end_seconds)

# ---------------------------------------------------------------- islands
func _islands(content: GameContent) -> void:
	md.append("## 5. Islands (legacy Era 2–3 static)")
	md.append("")
	if content.processing_catalog.is_empty():
		md.append("Processing catalog is not attached; Era 2–3 islands not analysed.")
		_finding("C10", "WARN", "processing catalog did not attach; Era 2 not analysed")
		return
	var catalog: Dictionary = content.processing_catalog
	var ref := _ref_buildings(content)
	var home_rates := Production.compute_rates(content, ref, 2.0)
	# Gate resources produced by islands/processing.
	var island_made := {}
	for island in IslandEconomy.ISLANDS:
		for rid in IslandEconomy.ISLANDS[island].rates:
			island_made[String(rid)] = island
	for rid in catalog.recipes:
		island_made[String(rid)] = "processing"
	md.append("| Era | gate resources | island/processing-made gate resources |")
	md.append("| --- | --- | --- |")
	var era2_island_gate := false
	for era_id in [1, 2, 3]:
		var def: Variant = content.era(era_id)
		if def == null:
			continue
		var gate := {}
		for rid in def.level_up_requirements.resources:
			gate[String(rid)] = true
		for rid in def.upgrade_requirements.capacity:
			gate[String(rid)] = true
		var made: Array = []
		for rid in gate:
			if island_made.has(rid) and not (rid in ["wood", "stone_low", "lingli", "money"]):
				made.append(rid)
			elif island_made.has(rid) and rid in ["wood", "stone_low"]:
				made.append(rid + " (home alias)")
		if era_id == 2 and not made.is_empty():
			era2_island_gate = true
		md.append("| %d | %s | %s |" % [era_id, ", ".join(gate.keys()), ", ".join(made) if not made.is_empty() else "none"])
	md.append("")
	md.append("Home resource rates at reference chain, Era 2 multiplier: wood %s/s, stone_low %s/s, lingli %s/s, money %s/s." % [Metrics.fmt(_f(home_rates.wood)), Metrics.fmt(_f(home_rates.stone_low)), Metrics.fmt(_f(home_rates.lingli)), Metrics.fmt(_f(home_rates.money))])
	md.append("")
	md.append("| island | extractor lvl | rate/s | storage lvl | cap | fill s (empty→full) |")
	md.append("| --- | --- | --- | --- | --- | --- |")
	var fill_hits: Array = []
	for island in ["wood", "ore", "herb"]:
		for lvl: int in [1, 2, 3]:
			var rate_sum := 0.0
			for rid in IslandEconomy.ISLANDS[island].rates:
				rate_sum = maxf(rate_sum, float(IslandEconomy.ISLANDS[island].rates[rid]) * float(lvl))
			var cap := 150.0 * float(lvl)
			var fill := Metrics.fill_seconds(cap, rate_sum)
			md.append("| %s | %d | %s | %d | %s | %s |" % [island, lvl, Metrics.fmt(rate_sum), lvl, Metrics.fmt(cap), Metrics.fmt(fill)])
	md.append("")
	md.append("Island output per extractor level is fixed (2/s × level); only storage (100 × level) bounds the idle stock. At equal extractor and storage level the fill time is constant (see table), i.e. upgrading both never changes the idle-waste window.")
	md.append("")
	# Facility sink exhaustion: all upgrades of the two Era-2 islands.
	var sink := {}
	for island in ["wood", "ore"]:
		for facility in IslandProgression.FACILITIES:
			for lvl in [1, 2]:
				var cost := IslandProgression.upgrade_cost(facility, lvl)
				for rid in cost:
					sink[rid] = float(sink.get(rid, 0.0)) + float(cost[rid])
	md.append("Total cost of every Era-2 island facility upgrade (wood+ore islands, 3 facilities × 2 upgrades): %s" % str(sink))
	var supply := {}
	for rid in ["wood", "stone_low"]:
		supply[rid] = _f(home_rates[rid])
	for rid in ["spirit_timber", "bronze_essence"]:
		var rec: Dictionary = catalog.recipes[rid]
		supply[rid] = float(rec.output) / float(IslandEconomy.DURATIONS[rid])
	var longest := 0.0
	var parts: PackedStringArray = []
	for rid in sink:
		var secs := Metrics.afford_seconds(float(sink[rid]), 0.0, float(supply.get(rid, 0.0)))
		longest = maxf(longest, secs)
		parts.append("%s %ss" % [rid, Metrics.fmt(secs)])
	md.append("")
	md.append("Serial production time per sink resource at supply rates: %s. Longest %ss." % [", ".join(parts), Metrics.fmt(longest)])
	md.append("")
	var era2_total: float = summary.chain_training_seconds.get(2, 0.0)
	summary["C10"] = {"sink_exhaust_seconds": longest, "era2_training_seconds": era2_total, "era2_gate_needs_island": era2_island_gate}
	var exhausted_share := longest / era2_total if era2_total > 0.0 else 0.0
	var sev := "OK"
	var notes: PackedStringArray = []
	if not era2_island_gate:
		sev = "WARN"
		notes.append("Era 2 level-up and breakthrough use no island/processing output (island chain is optional for Era 2 pacing)")
	if exhausted_share < 0.5:
		sev = "WARN"
		notes.append("all island facility upgrades could be done in %.0f%% of the Era-2 clock (%ss of %ss), leaving no mid-Era sink" % [exhausted_share * 100.0, Metrics.fmt(longest), Metrics.fmt(era2_total)])
	_finding("C10", sev, "; ".join(notes) if not notes.is_empty() else "island sinks outlast half of the Era 2 clock and gate on island output")

# ---------------------------------------------------------------- Era 4-6 supply chain
func _num(v: Variant) -> float:
	if v is AmountCompat:
		return (v as AmountCompat).to_float()
	if v is int or v is float:
		return float(v)
	var parsed := AmountCompat.try_parse(str(v))
	if bool(parsed.ok):
		return (parsed.value as AmountCompat).to_float()
	return 0.0

func _cost_text(cost: Dictionary) -> String:
	var parts: PackedStringArray = []
	for rid in cost:
		parts.append("%s %s" % [rid, Metrics.fmt(_num(cost[rid]))])
	return ", ".join(parts) if not parts.is_empty() else "-"

func _effect_text(effects: Dictionary) -> String:
	var parts: PackedStringArray = []
	for key in effects:
		parts.append("%s %s" % [key, Metrics.fmt(_num(effects[key]))])
	return ", ".join(parts) if not parts.is_empty() else "none"

func _era_demand(content: GameContent, era_id: int) -> Dictionary:
	var def: Variant = content.era(era_id)
	if def == null:
		return {}
	var totals := {}
	var per_level := {}
	for level in range(1, int(def.max_level)):
		var costs: Dictionary = Cultivation.level_up_cost(def, level, 0.0)
		for rid in costs:
			var key := String(rid)
			totals[key] = float(totals.get(key, 0.0)) + _num(costs[rid])
			per_level[key] = maxf(float(per_level.get(key, 0.0)), _num(costs[rid]))
	return {"totals": totals, "per_level": per_level, "capacity": def.upgrade_requirements.capacity.duplicate()}

func _island_rates(data: Dictionary, extractor_level: int, focus_built: bool) -> Dictionary:
	var rates := {}
	for island in IslandEconomy.ISLANDS:
		if island == "home":
			continue
		for rid in IslandEconomy.ISLANDS[island].rates:
			var key := String(rid)
			rates[key] = float(rates.get(key, 0.0)) + float(IslandEconomy.ISLANDS[island].rates[rid]) * float(extractor_level)
	for island in data.islands:
		var focus := String(data.get("dispatch", {}).get(island, ""))
		var mult := 2.0 if focus_built and focus != "" else 1.0
		for rid in data.islands[island].rates:
			var key := String(rid)
			rates[key] = float(rates.get(key, 0.0)) + float(data.islands[island].rates[rid]) * mult
	return rates

func _supply_rates(content: GameContent, data: Dictionary, durations: Dictionary, multiplier: float) -> Dictionary:
	var home := Production.compute_rates(content, _ref_buildings(content), multiplier)
	var home_rates := {}
	for rid in home:
		home_rates[String(rid)] = _num(home[rid])
	return {
		"home": home_rates, "island": _island_rates(data, 1, true),
		"catalog": content.processing_catalog, "durations": durations,
		"workshop": 1, "cache": {}, "visiting": {},
	}

func _full_rate(rid: String, ctx: Dictionary) -> float:
	var cache: Dictionary = ctx.cache
	if cache.has(rid):
		return float(cache[rid])
	var visiting: Dictionary = ctx.visiting
	if visiting.has(rid):
		return 0.0
	visiting[rid] = true
	var rate := float(ctx.island.get(rid, 0.0)) + float(ctx.home.get(rid, 0.0))
	var catalog: Dictionary = ctx.catalog
	for recipe_id in catalog.recipes:
		if ProcessingCatalog.product_id(catalog, String(recipe_id)) == rid:
			rate += _recipe_rate(String(recipe_id), ctx)
	visiting.erase(rid)
	cache[rid] = rate
	return rate

func _recipe_rate(rid: String, ctx: Dictionary) -> float:
	var catalog: Dictionary = ctx.catalog
	var recipe: Dictionary = catalog.recipes[rid]
	var out := _num(recipe.output)
	if out <= 0.0:
		return 0.0
	var base := float(ctx.durations.get(rid, 1))
	var duration := maxf(1.0, ceil(base / float(ctx.workshop)))
	var rate := out / duration
	for input in recipe.inputs:
		var per_output := _num(recipe.inputs[input]) / out
		if per_output <= 0.0:
			continue
		var available := _full_rate(String(input), ctx)
		if available <= 0.0:
			return 0.0
		rate = minf(rate, available / per_output)
	return rate

func _source_label(content: GameContent, data: Dictionary, rid: String, ctx: Dictionary) -> String:
	for island in data.islands:
		if data.islands[island].rates.has(rid):
			return "island:" + String(island)
	for island in IslandEconomy.ISLANDS:
		if IslandEconomy.ISLANDS[island].rates.has(rid):
			return "island:" + String(island)
	for recipe_id in content.processing_catalog.recipes:
		if ProcessingCatalog.product_id(content.processing_catalog, String(recipe_id)) == rid:
			return "recipe:" + String(recipe_id)
	if float(ctx.get("home", {}).get(rid, 0.0)) > 0.0:
		return "home:bldg"
	var def: Dictionary = content.resources.get(rid, {})
	return "home" if _num(def.get("rate", 0.0)) > 0.0 else "none"

func _supply_chain(content: GameContent) -> void:
	md.append("## 6. Era 4–6 supply chain (static, no player state)")
	md.append("")
	var loaded := SupplyContent.load_file()
	if not loaded.ok:
		md.append("Supply file could not be read: %s" % str(loaded.get("error", loaded.get("errors", ""))))
		_finding("C11", "WARN", "supply file failed: %s" % str(loaded.get("error", loaded.get("errors", ""))))
		return
	var data: Dictionary = loaded.data
	var durations: Dictionary = IslandEconomy.DURATIONS.duplicate()
	durations.merge(data.durations)
	md.append("Rates use the Era 1 reference building chain with each era's own resource multiplier, all supply islands opened, focus buildings built (island rate x2) and workshop level 1. A level-1 route moves 10 cargo per 10 s trip (1/s).")
	md.append("")
	var clocks := {}
	for era_id in [4, 5, 6]:
		clocks[era_id] = float(summary.chain_training_seconds.get(era_id, 0.0))
	var rate_ctx := {}
	var demand := {}
	md.append("### Demand vs supply per era")
	md.append("")
	md.append("`earn s` = Era-total requirement / steady supply rate; `share` = earn s / era training clock. `source` follows the real Production / recipe / island routing.")
	md.append("")
	md.append("| Era | clock min | resource | per-level | era total | supply/s | earn s | share | source |")
	md.append("| --- | --- | --- | --- | --- | --- | --- | --- | --- |")
	for era_id in [4, 5, 6]:
		var era_def: Variant = content.era(era_id)
		if era_def == null:
			continue
		var ctx := _supply_rates(content, data, durations, float(era_def.resource_multiplier))
		rate_ctx[era_id] = ctx
		var need := _era_demand(content, era_id)
		demand[era_id] = need
		var totals: Dictionary = need.totals
		for rid in totals:
			var total := float(totals[rid])
			var rate := _full_rate(String(rid), ctx)
			var secs := Metrics.afford_seconds(total, 0.0, rate)
			var share_text := "INF"
			if rate > 0.0 and clocks[era_id] > 0.0:
				share_text = "%.1f%%" % (secs / clocks[era_id] * 100.0)
			md.append("| %d | %.0f | %s | %s | %s | %s | %s | %s | %s |" % [era_id, clocks[era_id] / 60.0, rid, Metrics.fmt(float(need.per_level.get(rid, 0.0))), Metrics.fmt(total), Metrics.fmt(rate), Metrics.fmt(secs), share_text, _source_label(content, data, String(rid), ctx)])
	md.append("")
	var ref := _ref_buildings(content)
	var built_caps_by_era := {}
	var ref_caps_by_era := {}
	for era_id in [4, 5, 6]:
		var buildings := ref.duplicate()
		for id in content.building_ids:
			var bdef: Dictionary = content.buildings[id]
			if int(bdef.era) <= era_id:
				buildings[id] = maxi(int(buildings.get(id, 0)), 1)
		built_caps_by_era[era_id] = Production.compute_caps(content, buildings, era_id, 1)
		ref_caps_by_era[era_id] = Production.compute_caps(content, ref, era_id, 1)
	md.append("### Breakthrough stock requirement vs cap")
	md.append("")
	md.append("Built cap = reference chain plus every supply building whose era is at most the current era, each at level 1. A stock requirement above the cap is a hard breakthrough deadlock.")
	md.append("")
	md.append("| Era | resource | stock required | built cap | headroom | per-level | verdict |")
	md.append("| --- | --- | --- | --- | --- | --- | --- |")
	var stock_deadlocks: Array = []
	var stock_tight: Array = []
	for era_id in [4, 5, 6]:
		if not demand.has(era_id):
			continue
		var capacity: Dictionary = demand[era_id].capacity
		if capacity.is_empty():
			md.append("| %d | - | none declared | - | - | - | Era 7 not implemented |" % era_id)
			continue
		for rid in capacity:
			var required := _num(capacity[rid])
			var built_cap := _num(built_caps_by_era[era_id].get(rid, 0.0))
			var per := float(demand[era_id].per_level.get(rid, 0.0))
			var headroom := built_cap / maxf(required, 0.001)
			var verdict := "ok"
			if built_cap < required:
				verdict = "DEADLOCK"
				stock_deadlocks.append("%s E%d" % [rid, era_id])
			elif headroom < 1.5:
				verdict = "tight"
				stock_tight.append("%s E%d (%.2fx)" % [rid, era_id, headroom])
			md.append("| %d | %s | %s | %s | %s | %s | %s |" % [era_id, rid, Metrics.fmt(required), Metrics.fmt(built_cap), Metrics.fmt(headroom), ("-" if per <= 0.0 else Metrics.fmt(per)), verdict])
	md.append("")
	md.append("### Per-level cost vs cap")
	md.append("")
	md.append("| Era | resource | per-level | ref cap | built cap | headroom | verdict |")
	md.append("| --- | --- | --- | --- | --- | --- | --- |")
	var cap_deadlocks: Array = []
	var cap_low: Array = []
	for era_id in [4, 5, 6]:
		if not demand.has(era_id):
			continue
		for rid in demand[era_id].totals:
			var per := float(demand[era_id].per_level.get(rid, 0.0))
			var ref_cap := _num(ref_caps_by_era[era_id].get(rid, 0.0))
			var built_cap := _num(built_caps_by_era[era_id].get(rid, 0.0))
			var headroom := built_cap / maxf(per, 0.001)
			var verdict := "ok"
			if built_cap < per:
				verdict = "DEADLOCK"
				cap_deadlocks.append("%s E%d" % [rid, era_id])
			elif headroom < 2.0:
				verdict = "low"
				cap_low.append("%s E%d (%.2fx)" % [rid, era_id, headroom])
			md.append("| %d | %s | %s | %s | %s | %s | %s |" % [era_id, rid, Metrics.fmt(per), Metrics.fmt(ref_cap), Metrics.fmt(built_cap), Metrics.fmt(headroom), verdict])
	md.append("")
	var era3: Variant = content.era(3)
	if era3 != null:
		rate_ctx[3] = _supply_rates(content, data, durations, float(era3.resource_multiplier))
	# Supply building acquisition cost against the era clock.
	md.append("### Supply building acquisition cost")
	md.append("")
	md.append("`gather s` = slowest single cost resource at that era's steady rate. `clock share` compares it with the era training clock; a large share means the building waits on income rather than on the player's choice.")
	md.append("")
	md.append("| building | era | max | cost | gather s | clock share | effect |")
	md.append("| --- | --- | --- | --- | --- | --- | --- |")
	var expensive: Array = []
	for definition in data.buildings:
		var b_era := int(definition.get("era", 4))
		var ctx_era := clampi(b_era, 3, 6)
		if not rate_ctx.has(ctx_era):
			continue
		var ctx: Dictionary = rate_ctx[ctx_era]
		var cost: Dictionary = definition.get("base_cost", {})
		var worst := 0.0
		var worst_id := ""
		for rid in cost:
			var r := _full_rate(String(rid), ctx)
			if r <= 0.0:
				worst = INF
				worst_id = String(rid) + ":none"
				break
			var secs := _num(cost[rid]) / r
			if secs > worst:
				worst = secs
				worst_id = String(rid)
		var clock := float(summary.chain_training_seconds.get(ctx_era, 0.0))
		var share := worst / clock if clock > 0.0 and worst < INF else INF
		var share_text := "INF" if share == INF else "%.1f%%" % (share * 100.0)
		if share > float(thresholds.C16_clock_share_max):
			expensive.append("%s (%s)" % [String(definition.get("id", "?")), share_text])
		md.append("| %s | %d | %d | %s | %s | %s | %s |" % [String(definition.get("id", "?")), b_era, int(definition.get("max_level", 1)), _cost_text(cost), ("INF" if worst == INF else Metrics.fmt(worst)), share_text, _effect_text(definition.get("effects", {}))])
	md.append("")
	# Island supply and transport.
	md.append("### Island supply and transport")
	md.append("")
	md.append("| island | era | product | base rate/s | focus rate/s | local cap | fill s (focus) | route | throughput/s | route default |")
	md.append("| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
	for island in data.islands:
		var island_def: Dictionary = data.islands[island]
		for product in island_def.rates:
			var route_id := ""
			for rid in data.routes:
				if String(data.routes[rid][0]) == String(island) and String(data.routes[rid][2]) == String(product):
					route_id = String(rid)
					break
			var base := float(island_def.rates[product])
			var cap := float(island_def.get("local_cap", 150))
			var route_default := "on" if bool(data.get("route_policy", {}).get("enabled", false)) else "off"
			md.append("| %s | %d | %s | %s | %s | %s | %s | %s | %s | %s |" % [island, int(island_def.era), product, Metrics.fmt(base), Metrics.fmt(base * 2.0), Metrics.fmt(cap), Metrics.fmt(Metrics.fill_seconds(cap, base * 2.0)), route_id if route_id != "" else "-", Metrics.fmt(1.0 if route_id != "" else 0.0), route_default])
	for island in ["wood", "ore", "herb"]:
		var island_def: Dictionary = IslandEconomy.ISLANDS[island]
		for product in island_def.rates:
			var route_id := ""
			for rid in IslandEconomy.ROUTES:
				if String(IslandEconomy.ROUTES[rid][0]) == String(island) and String(IslandEconomy.ROUTES[rid][1]) == "home" and String(IslandEconomy.ROUTES[rid][2]) == String(product):
					route_id = String(rid)
					break
			var base := float(island_def.rates[product]) * 3.0
			var cap := IslandProgression.capacity_for_level(3)
			md.append("| %s | %d | %s | %s | %s | %s | %s | %s | %s | off |" % [island, int(island_def.era), product, Metrics.fmt(base), Metrics.fmt(base), Metrics.fmt(cap), Metrics.fmt(Metrics.fill_seconds(cap, base)), route_id if route_id != "" else "-", Metrics.fmt(3.0 if route_id != "" else 0.0)])
	md.append("")
	md.append("Legacy rows use extractor and storage level 3 and the level-3 route throughput (3/s). Supply islands have a fixed rate and no extractor levels; `focus` is the dispatch building effect.")
	md.append("")
	# Recipe chain bottlenecks.
	md.append("### Recipe chain bottlenecks (workshop 1)")
	md.append("")
	md.append("Input-limited rate already includes the input's own recipe/island supply. `missing` means an input has no source at any era.")
	md.append("")
	md.append("| recipe | era | product | process rate/s | achievable rate/s | bottleneck |")
	md.append("| --- | --- | --- | --- | --- | --- |")
	var bottlenecks := {}
	for recipe_id in content.processing_catalog.recipes:
		var recipe: Dictionary = content.processing_catalog.recipes[String(recipe_id)]
		var era_id := clampi(int(recipe.era), 4, 6)
		if not rate_ctx.has(era_id):
			continue
		var ctx: Dictionary = rate_ctx[era_id]
		var out := _num(recipe.output)
		var base := float(durations.get(String(recipe_id), 1))
		var process := out / maxf(1.0, ceil(base / float(ctx.workshop)))
		var achievable := _recipe_rate(String(recipe_id), ctx)
		var bottleneck := "-"
		var worst := INF
		for input in recipe.inputs:
			var per_output := _num(recipe.inputs[input]) / maxf(out, 0.001)
			var available := _full_rate(String(input), ctx)
			var limit := available / per_output if per_output > 0.0 else INF
			if available <= 0.0:
				bottleneck = "missing:" + String(input)
				worst = -1.0
				break
			if limit < worst:
				worst = limit
				bottleneck = String(input)
		if achievable <= 0.0 and bottleneck == "-":
			bottleneck = "process"
		bottlenecks[String(recipe_id)] = {"process": process, "achievable": achievable, "bottleneck": bottleneck}
		md.append("| %s | %d | %s | %s | %s | %s |" % [recipe_id, int(recipe.era), ProcessingCatalog.product_id(content.processing_catalog, String(recipe_id)), Metrics.fmt(process), Metrics.fmt(achievable), bottleneck])
	md.append("")
	summary["supply"] = {"clocks": clocks, "demand": demand, "bottlenecks": bottlenecks}
	# ---- findings
	var deadlocks: Array = []
	var gated: Array = []
	var trivial: Array = []
	for era_id in demand:
		for rid in demand[era_id].totals:
			var total := float(demand[era_id].totals[rid])
			if total <= 0.0:
				continue
			var rate := _full_rate(String(rid), rate_ctx[era_id])
			if rate <= 0.0:
				deadlocks.append("%s E%d" % [rid, era_id])
				continue
			var share := (total / rate) / maxf(clocks[era_id], 0.001)
			if share > float(thresholds.C11_gate_share_max):
				gated.append("%s E%d (%.0f%%)" % [rid, era_id, share * 100.0])
			elif share < float(thresholds.C11_trivial_share):
				trivial.append("%s E%d (%.1f%%)" % [rid, era_id, share * 100.0])
	summary["C11"] = {"deadlocks": deadlocks.size(), "gated": gated.size(), "trivial": trivial.size()}
	var sev11 := "OK"
	var text11: PackedStringArray = []
	if not deadlocks.is_empty():
		sev11 = "FAIL"
		text11.append("no supply: " + ", ".join(deadlocks))
	if not gated.is_empty():
		if sev11 == "OK": sev11 = "WARN"
		text11.append("resource-gated (earn > clock): " + ", ".join(gated))
	if not trivial.is_empty():
		if sev11 == "OK": sev11 = "WARN"
		text11.append("island/recipe share below %s%% of clock: %s" % [Metrics.fmt(float(thresholds.C11_trivial_share) * 100.0), ", ".join(trivial)])
	_finding("C11", sev11, "Era 4–6 requirement coverage: " + ("; ".join(text11) if not text11.is_empty() else "every requirement is earnable inside its era clock"))
	var sev12 := "OK"
	var text12: PackedStringArray = []
	if not cap_deadlocks.is_empty() or not stock_deadlocks.is_empty():
		sev12 = "FAIL"
		if not cap_deadlocks.is_empty():
			text12.append("per-level cost above built cap: " + ", ".join(cap_deadlocks))
		if not stock_deadlocks.is_empty():
			text12.append("breakthrough stock above built cap: " + ", ".join(stock_deadlocks))
	if not cap_low.is_empty():
		if sev12 == "OK": sev12 = "WARN"
		text12.append("per-level cap headroom below 2x: " + ", ".join(cap_low))
	if not stock_tight.is_empty():
		if sev12 == "OK": sev12 = "WARN"
		text12.append("breakthrough stock headroom below 1.5x: " + ", ".join(stock_tight))
	summary["C12"] = {"cap_deadlocks": cap_deadlocks.size(), "stock_deadlocks": stock_deadlocks.size(), "cap_low": cap_low.size(), "stock_tight": stock_tight.size()}
	_finding("C12", sev12, "Era 4–6 capacity: " + ("; ".join(text12) if not text12.is_empty() else "every cost and breakthrough stock fits inside the built caps"))
	# Island surplus per demanded product.
	var over: Array = []
	var under: Array = []
	var orphan_demands: Array = []
	for product in data.islands:
		for rid in data.islands[product].rates:
			var total := 0.0
			var clock := 0.0
			var clock_era := 4
			for era_id in demand:
				if demand[era_id].totals.has(rid):
					total += float(demand[era_id].totals[rid])
					if clocks[era_id] > clock:
						clock = clocks[era_id]
						clock_era = era_id
			if total <= 0.0:
				orphan_demands.append(String(rid))
				continue
			var rate := _full_rate(String(rid), rate_ctx.get(clock_era, rate_ctx[4]))
			var supplied := rate * clock
			var surplus := supplied / total
			if surplus > float(thresholds.C12_island_surplus_max):
				over.append("%s (%.0fx)" % [rid, surplus])
			elif surplus < 1.0:
				under.append("%s (%.2fx)" % [rid, surplus])
	summary["C13"] = {"over": over.size(), "under": under.size(), "orphans": orphan_demands.size()}
	var sev13 := "OK"
	var text13: PackedStringArray = []
	if not under.is_empty():
		sev13 = "WARN"
		text13.append("island cannot meet demand: " + ", ".join(under))
	if not over.is_empty():
		if sev13 == "OK": sev13 = "WARN"
		text13.append("island output far above demand: " + ", ".join(over))
	_finding("C13", sev13, "Island demand coupling: " + ("; ".join(text13) if not text13.is_empty() else "island output is within the configured band of Era 4–6 demand"))
	var disabled: Array = []
	if not bool(data.get("route_policy", {}).get("enabled", true)):
		disabled.append("route_policy.enabled=false")
	var route_text := "route_policy.enabled=false; supply-island local cap 300 discards output until routes are switched on manually" if not disabled.is_empty() else "supply routes open with the island and target the home cap; a level-1 route moves up to 1/s, above each island's 0.04-0.10/s base rate"
	_finding("C14", "WARN" if not disabled.is_empty() else "OK", "Transport defaults: " + route_text)
	var used := {}
	for era_id in demand:
		for rid in demand[era_id].totals:
			used[String(rid)] = true
		for rid in demand[era_id].capacity:
			used[String(rid)] = true
	for island in data.islands:
		for rid in data.islands[island].get("cost", {}):
			used[String(rid)] = true
	for definition in data.buildings:
		for rid in definition.get("base_cost", {}):
			used[String(rid)] = true
	for recipe_id in content.processing_catalog.recipes:
		for rid in content.processing_catalog.recipes[recipe_id].inputs:
			used[String(rid)] = true
	var orphans: Array = []
	for rid in data.resources:
		if not used.has(String(rid)):
			orphans.append(String(rid))
	summary["C15"] = {"orphans": orphans}
	_finding("C15", "WARN" if not orphans.is_empty() else "OK", "Tier-2 resources with no Era 4–6 gate, island cost, building cost or recipe use: %s" % (", ".join(orphans) if not orphans.is_empty() else "none"))
	summary["C16"] = {"expensive": expensive.size()}
	_finding("C16", "WARN" if not expensive.is_empty() else "OK", "Supply building acquisition above %s%% of its era clock: %s" % [Metrics.fmt(float(thresholds.C16_clock_share_max) * 100.0), (", ".join(expensive) if not expensive.is_empty() else "none")])

# ---------------------------------------------------------------- output
func _write_findings() -> void:
	md.append("## 7. Findings")
	md.append("")
	md.append("| ID | status | detail |")
	md.append("| --- | --- | --- |")
	for f in findings:
		md.append("| %s | %s | %s |" % [f.id, f.severity, String(f.text).replace("|", "/")])
	md.append("")

func _save() -> void:
	var file := FileAccess.open(OUT_MD, FileAccess.WRITE)
	if file == null:
		push_error("cannot write %s" % OUT_MD)
		return
	file.store_string("\n".join(md))
	file.close()
	var json := FileAccess.open(OUT_JSON, FileAccess.WRITE)
	if json != null:
		json.store_string(JSON.stringify({"findings": findings, "summary": summary}, "  "))
		json.close()
