extends SceneTree
## Early-game pacing audit (report mode). Does not change any game value.
## Run: godot --headless --path . --script res://tools/early_pacing_audit.gd [-- --enforce]
## Writes docs/verification/early-pacing-baseline.md and .json.
## Formulas: src/utils/pacing_metrics.gd; thresholds: tools/early_pacing_targets.json;
## strategies: src/utils/pacing_sim.gd. Rates/costs/caps come from the real rules.

const Metrics = preload("res://src/utils/pacing_metrics.gd")
const Sim = preload("res://src/utils/pacing_sim.gd")
const OUT_MD := "res://docs/verification/early-pacing-baseline.md"
const OUT_JSON := "res://docs/verification/early-pacing-baseline.json"
const LEVEL_CAP := 10

var targets: Dictionary
var thresholds: Dictionary
var assumptions: Dictionary
var md: PackedStringArray = []
var findings: Array = []
var summary := {}

func _init() -> void:
	call_deferred("_run")

func _run() -> void:
	targets = JSON.parse_string(FileAccess.get_file_as_string("res://tools/early_pacing_targets.json"))
	thresholds = targets.thresholds
	assumptions = targets.assumptions
	var base := ContentLoader.load_directory("res://content")
	if not bool(base.ok):
		push_error("content failed: %s" % str(base.errors))
		quit(2)
		return
	var content: GameContent = base.content
	md.append("# Early pacing baseline (auto-generated)")
	md.append("")
	md.append("Generated by `tools/early_pacing_audit.gd`. Report mode: no game value is changed. Thresholds: `tools/early_pacing_targets.json`.")
	md.append("")
	_era_chain(content)
	_era1_static(content)
	_era1_coupling(content)
	_era1_simulation(content)
	_era2_islands()
	_write_findings()
	_save()
	var enforce := "--enforce" in OS.get_cmdline_user_args()
	var failing := 0
	for f in findings:
		if f.severity == "FAIL":
			failing += 1
	print("PACING AUDIT: %d findings, %d FAIL (see %s)" % [findings.size(), failing, OUT_MD])
	quit(1 if enforce and failing > 0 else 0)

func _f(a: Variant) -> float:
	return (a as AmountCompat).to_float()

func _finding(id: String, severity: String, text: String) -> void:
	findings.append({"id": id, "severity": severity, "text": text})

# ---------------------------------------------------------------- era chain
func _era_chain(content: GameContent) -> void:
	md.append("## 1. Cultivation clock (wall-clock gate)")
	md.append("")
	md.append("| Era | max level | base s | mult | total training s | total min | level-up cost | breakthrough capacity |")
	md.append("| --- | --- | --- | --- | --- | --- | --- | --- |")
	var chains := {}
	for era_id in [1, 2, 3]:
		var def: Variant = content.era(era_id)
		if def == null:
			var raw: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://content/eras/era%d.json" % era_id))
			def = raw[0] if raw is Array and not raw.is_empty() else null
		if def == null:
			continue
		var req: Dictionary = def.level_up_requirements
		var total := Metrics.chain_training_seconds(float(req.base_time), float(req.time_multiplier), int(def.max_level))
		chains[era_id] = total
		md.append("| %d | %d | %s | %s | %s | %.1f | %s | %s |" % [era_id, int(def.max_level), str(req.base_time), str(req.time_multiplier), Metrics.fmt(total), total / 60.0, str(req.resources), str(def.upgrade_requirements.capacity)])
	md.append("")
	summary["chain_training_seconds"] = chains

# ---------------------------------------------------------------- static Era 1
func _ref_buildings(content: GameContent) -> Dictionary:
	var ref := {}
	for id in content.building_ids:
		ref[id] = 0
	for id in assumptions.reference_chain:
		ref[id] = int(assumptions.reference_chain[id])
	return ref

func _produced_keys(def: Dictionary) -> Array:
	var keys: Array = []
	for k in def.effects:
		if not String(k).ends_with("_max") and String(k) != "synthetic_max_mult":
			keys.append(String(k))
	return keys

func _era1_static(content: GameContent) -> void:
	md.append("## 2. Era 1 per-step table (reference state = onboarding chain done)")
	md.append("")
	md.append("Rates, caps and costs come from `Production` / `BuildingCosts`. Columns: `afford` = seconds to pay the worst cost resource from empty at reference rates; `pressure` = min over cost resources of cap/cost; `ratio` = afford / fill time of that resource; `gain` = relative rate gain of the next level; `delay@300` = production lost if the purchase is made 300 s late; `ovf@300` = fraction of production discarded if the store is emptied every 300 s.")
	md.append("")
	var ref := _ref_buildings(content)
	var rates_ref := Production.compute_rates(content, ref, 1.0)
	var caps_ref := Production.compute_caps(content, ref, 1, 1)
	var n_levels := mini(int(assumptions.static_levels_per_building), LEVEL_CAP)
	var c1: Array = []
	var c2: Array = []
	var c3: Array = []
	var c4: Array = []
	var c5: Array = []
	var c6: Array = []
	var total_rows := 0
	for id in content.building_ids:
		var def: Dictionary = content.buildings[id]
		if int(def.era) != 1:
			continue
		var produced := _produced_keys(def)
		md.append("### %s (%s)" % [id, "rate: " + ",".join(produced) if not produced.is_empty() else "capacity only"])
		md.append("")
		md.append("| L→L+1 | cost | afford s | pressure | ratio | gain | delay@300 | ovf@300 |")
		md.append("| --- | --- | --- | --- | --- | --- | --- | --- |")
		for level in range(0, mini(n_levels, int(def.max_level))):
			total_rows += 1
			var costs := BuildingCosts.compute_cost(BuildingCosts.resolve_base_cost(id, def.base_cost, true), level, float(def.cost_factor))
			var worst_afford := 0.0
			var min_pressure := Metrics.INF_SECONDS
			var worst_ratio := 0.0
			var cost_text: PackedStringArray = []
			for rid in costs:
				var cost := _f(costs[rid])
				cost_text.append("%s %s" % [rid, Metrics.fmt(cost)])
				var rate := _f(rates_ref[rid])
				var cap := _f(caps_ref[rid])
				var afford := Metrics.afford_seconds(cost, 0.0, rate)
				var pressure := Metrics.cap_pressure(cap, cost)
				var fill := Metrics.fill_seconds(cap, rate)
				worst_afford = maxf(worst_afford, afford)
				min_pressure = minf(min_pressure, pressure)
				if fill > 0.0:
					worst_ratio = maxf(worst_ratio, afford / fill)
			var gain_text := "-"
			var delay_text := "-"
			var ovf_text := "-"
			if not produced.is_empty():
				var b0 := ref.duplicate()
				b0[id] = level
				var b1 := ref.duplicate()
				b1[id] = level + 1
				var r0 := Production.compute_rates(content, b0, 1.0)
				var r1 := Production.compute_rates(content, b1, 1.0)
				var d_total := 0.0
				var base_total := 0.0
				for key in produced:
					if r0.has(key):
						d_total += _f(r1[key]) - _f(r0[key])
						base_total += _f(r0[key])
				var gain := Metrics.gain_ratio(base_total, base_total + d_total)
				gain_text = "%.0f%%" % (gain * 100.0)
				delay_text = Metrics.fmt(Metrics.delay_loss(d_total, 300.0))
				var first: String = produced[0]
				if r1.has(first):
					var ovf := Metrics.overflow_ratio(_f(caps_ref[first]), _f(r1[first]), 300.0)
					ovf_text = "%.0f%%" % (ovf * 100.0)
					if not Metrics.in_band(ovf, float(thresholds.C6_overflow_low), float(thresholds.C6_overflow_high)):
						c6.append("%s L%d (%s %.0f%%)" % [id, level, first, ovf * 100.0])
				if level < int(thresholds.C5_levels_checked) and gain < float(thresholds.C5_min_gain_first_levels):
					c5.append("%s L%d (%.0f%%)" % [id, level, gain * 100.0])
			if min_pressure < 1.0:
				c1.append("%s L%d" % [id, level])
			if not Metrics.in_band(min_pressure, float(thresholds.C2_pressure_low), float(thresholds.C2_pressure_high)):
				c2.append("%s L%d (%s)" % [id, level, Metrics.fmt(min_pressure)])
			if not Metrics.in_band(worst_afford, float(thresholds.C3_afford_low_seconds), float(thresholds.C3_afford_high_seconds)):
				c3.append("%s L%d (%ss)" % [id, level, Metrics.fmt(worst_afford)])
			if not Metrics.in_band(worst_ratio, float(thresholds.C4_afford_fill_low), float(thresholds.C4_afford_fill_high)):
				c4.append("%s L%d (%s)" % [id, level, Metrics.fmt(worst_ratio)])
			md.append("| %d→%d | %s | %s | %s | %s | %s | %s | %s |" % [level, level + 1, ", ".join(cost_text), Metrics.fmt(worst_afford), Metrics.fmt(min_pressure), Metrics.fmt(worst_ratio), gain_text, delay_text, ovf_text])
		md.append("")
	_check("C1", "deadlock: cap < next cost", c1, total_rows, "FAIL")
	_check("C2", "capacity pressure out of band [%s, %s]" % [str(thresholds.C2_pressure_low), str(thresholds.C2_pressure_high)], c2, total_rows, "WARN")
	_check("C3", "afford time out of [%ss, %ss]" % [str(thresholds.C3_afford_low_seconds), str(thresholds.C3_afford_high_seconds)], c3, total_rows, "WARN")
	_check("C4", "afford/fill ratio out of [%s, %s]" % [str(thresholds.C4_afford_fill_low), str(thresholds.C4_afford_fill_high)], c4, total_rows, "WARN")
	_check("C5", "rate gain below %.0f%% in first %d levels" % [float(thresholds.C5_min_gain_first_levels) * 100.0, int(thresholds.C5_levels_checked)], c5, total_rows, "WARN")
	_check("C6", "5-minute idle overflow out of [%.0f%%, %.0f%%]" % [float(thresholds.C6_overflow_low) * 100.0, float(thresholds.C6_overflow_high) * 100.0], c6, total_rows, "WARN")

func _check(id: String, label: String, hits: Array, rows: int, severity: String) -> void:
	summary[id] = {"violations": hits.size(), "rows": rows}
	if hits.is_empty():
		_finding(id, "OK", "%s: none (%d rows)" % [label, rows])
		return
	var sample := hits.slice(0, 8)
	_finding(id, severity, "%s: %d/%d rows. e.g. %s%s" % [label, hits.size(), rows, ", ".join(sample), " ..." if hits.size() > 8 else ""])

# ---------------------------------------------------------------- coupling
func _era1_coupling(content: GameContent) -> void:
	md.append("## 3. Gate coupling (C8)")
	md.append("")
	var gate := {}
	for era_id in [1, 2]:
		var def: Dictionary = content.era(era_id)
		for rid in def.level_up_requirements.resources:
			gate[String(rid)] = true
		for rid in def.upgrade_requirements.capacity:
			gate[String(rid)] = true
	md.append("Gate resources (level-up cost and breakthrough capacity, Era 1–2): %s" % ", ".join(gate.keys()))
	md.append("")
	var required := {}
	for id in assumptions.reference_chain:
		required[id] = int(assumptions.reference_chain[id])
	var hard := {}
	for id in content.building_ids:
		var def: Dictionary = content.buildings[id]
		if int(def.era) != 1:
			continue
		for key in def.effects:
			var target := String(key).trim_suffix("_max")
			if gate.has(target):
				hard[id] = true
	var changed := true
	while changed:
		changed = false
		for id in hard.keys():
			var prereq: Variant = content.buildings[id].prereq
			if prereq != null and not hard.has(String(prereq.building)):
				hard[String(prereq.building)] = true
				changed = true
	md.append("| building | required lvl | level cap | headroom | gate-coupled |")
	md.append("| --- | --- | --- | --- | --- |")
	var headroom_total := 0
	var headroom_free := 0
	var orphans: Array = []
	for id in content.building_ids:
		var def: Dictionary = content.buildings[id]
		if int(def.era) != 1:
			continue
		var cap := mini(int(def.max_level), LEVEL_CAP)
		var req: int = int(required.get(id, 0))
		var headroom := maxi(0, cap - req)
		# A coupled building still has no gate effect once its gate-producing levels are maxed.
		var gate_effect := false
		for key in def.effects:
			if gate.has(String(key).trim_suffix("_max")):
				gate_effect = true
		var useful_headroom := headroom if gate_effect else 0
		headroom_total += headroom
		headroom_free += headroom - useful_headroom
		if not gate_effect:
			orphans.append(id)
		md.append("| %s | %d | %d | %d | %s |" % [id, req, cap, headroom, "direct" if gate_effect else ("prereq only" if hard.has(id) else "NONE")])
	md.append("")
	var share := float(headroom_free) / float(maxi(1, headroom_total))
	md.append("Headroom levels beyond the onboarding chain: %d, of which %d (%.0f%%) do not raise any gate resource rate or capacity." % [headroom_total, headroom_free, share * 100.0])
	md.append("")
	summary["C8"] = {"headroom_total": headroom_total, "headroom_free": headroom_free, "share": share}
	var sev := "WARN" if share > 0.5 else "OK"
	_finding("C8", sev, "gate-irrelevant headroom share %.0f%% (%d/%d levels); buildings without a direct gate effect: %s" % [share * 100.0, headroom_free, headroom_total, ", ".join(orphans)])

# ---------------------------------------------------------------- simulation
func _era1_simulation(content: GameContent) -> void:
	md.append("## 4. Active vs idle simulation (real GameSession, Era 1)")
	md.append("")
	md.append("Assumptions: active = %d clicks/s, acts every second; idle = returns every %d s, %d clicks per visit, buys greedily. Score horizon %d s. Pills (聚靈丹) are only used after the onboarding chain." % [int(assumptions.active_clicks_per_second), int(assumptions.idle_visit_interval_seconds), int(assumptions.idle_visit_clicks), int(assumptions.score_horizon_seconds)])
	md.append("")
	var params := {
		"max_seconds": int(assumptions.sim_max_seconds), "horizon": int(assumptions.score_horizon_seconds),
		"clicks_per_second": int(assumptions.active_clicks_per_second),
		"interval": int(assumptions.idle_visit_interval_seconds), "visit_clicks": int(assumptions.idle_visit_clicks),
		"use_pills": false,
	}
	var runs := {}
	for pills in [false, true]:
		for mode in ["active", "idle"]:
			var p := params.duplicate()
			p.use_pills = pills
			var sim = Sim.new(content)
			runs["%s_%s" % [mode, "pills" if pills else "nopills"]] = sim.run(mode, p)
	md.append("| run | chain done s | lv10 s | breakthrough-ready s | bldg levels @H | cult lvl @H | purchases | clicks | pills | stuck |")
	md.append("| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
	for key in runs:
		var r: Dictionary = runs[key]
		md.append("| %s | %s | %s | %s | %d | %d | %d | %d | %d | %s |" % [key, _t(r.t_chain_done), _t(r.t_lv10), _t(r.t_ready), r.levels_at_horizon, r.cult_level_at_horizon, r.purchases, r.clicks, r.pills, str(r.stuck)])
	md.append("")
	md.append("Overflow lost to caps (estimate, units): ")
	md.append("")
	for key in runs:
		md.append("- %s: %s" % [key, str(runs[key].overflow)])
	md.append("")
	summary["sim"] = runs
	var a: Dictionary = runs.active_nopills
	var i: Dictionary = runs.idle_nopills
	var ratio_levels := float(a.levels_at_horizon) / float(maxi(1, i.levels_at_horizon))
	var chain_ratio := 0.0
	if a.t_chain_done > 0.0 and i.t_chain_done > 0.0:
		chain_ratio = i.t_chain_done / a.t_chain_done
	_finding("C7", "OK" if ratio_levels >= float(thresholds.C7_active_over_idle_min) else "WARN", "active/idle building levels @%ds = %.2fx (target >= %.1fx); chain completion idle/active = %.2fx" % [int(assumptions.score_horizon_seconds), ratio_levels, float(thresholds.C7_active_over_idle_min), chain_ratio])
	var end_a := _end(a)
	var end_i := _end(i)
	var share_nopill := Metrics.reducible_share(end_i, end_a)
	var share_pill := Metrics.reducible_share(_end(runs.idle_pills), _end(runs.active_pills))
	summary["C9"] = {"reducible_nopills": share_nopill, "reducible_pills": share_pill}
	var s9 := "OK" if maxf(share_nopill, share_pill) >= float(thresholds.C9_reducible_share_min) else "WARN"
	_finding("C9", s9, "time to breakthrough-ready: idle %.0fs vs active %.0fs without pills (reducible %.0f%%); with pills idle %.0fs vs active %.0fs (reducible %.0f%%); target >= %.0f%%" % [end_i, end_a, share_nopill * 100.0, _end(runs.idle_pills), _end(runs.active_pills), share_pill * 100.0, float(thresholds.C9_reducible_share_min) * 100.0])

func _t(v: float) -> String:
	return "-" if v < 0.0 else "%.0f" % v

func _end(r: Dictionary) -> float:
	return float(r.t_ready) if float(r.t_ready) >= 0.0 else float(r.end_seconds)

# ---------------------------------------------------------------- Era 2 islands
func _era2_islands() -> void:
	md.append("## 5. Era 2 islands (static)")
	md.append("")
	var loaded := ContentLoader.load_directory("res://content")
	var content: GameContent = loaded.content
	var attach := IslandProgression.attach(content)
	if attach is Dictionary and attach.has("ok") and not bool(attach.ok):
		md.append("Island content could not be attached: %s" % str(attach))
		_finding("C10", "WARN", "island content did not attach; Era 2 not analysed")
		return
	var catalog: Dictionary = content.processing_catalog
	var ref := _ref_buildings(content)
	var home_rates := Production.compute_rates(content, ref, 2.0)
	# Gate resources produced by islands/processing.
	var island_made := {}
	for island in IslandEconomy.ISLANDS:
		for rid in IslandEconomy.ISLANDS[island].rates:
			island_made[String(rid)] = island
	for rid in catalog.recipes:
		island_made[String(rid)] = "processing"
	md.append("| Era | gate resources | island/processing-made gate resources |")
	md.append("| --- | --- | --- |")
	var era2_island_gate := false
	for era_id in [1, 2, 3]:
		var def: Variant = content.era(era_id)
		if def == null:
			continue
		var gate := {}
		for rid in def.level_up_requirements.resources:
			gate[String(rid)] = true
		for rid in def.upgrade_requirements.capacity:
			gate[String(rid)] = true
		var made: Array = []
		for rid in gate:
			if island_made.has(rid) and not (rid in ["wood", "stone_low", "lingli", "money"]):
				made.append(rid)
			elif island_made.has(rid) and rid in ["wood", "stone_low"]:
				made.append(rid + " (home alias)")
		if era_id == 2 and not made.is_empty():
			era2_island_gate = true
		md.append("| %d | %s | %s |" % [era_id, ", ".join(gate.keys()), ", ".join(made) if not made.is_empty() else "none"])
	md.append("")
	md.append("Home resource rates at reference chain, Era 2 multiplier: wood %s/s, stone_low %s/s, lingli %s/s, money %s/s." % [Metrics.fmt(_f(home_rates.wood)), Metrics.fmt(_f(home_rates.stone_low)), Metrics.fmt(_f(home_rates.lingli)), Metrics.fmt(_f(home_rates.money))])
	md.append("")
	md.append("| island | extractor lvl | rate/s | storage lvl | cap | fill s (empty→full) |")
	md.append("| --- | --- | --- | --- | --- | --- |")
	var fill_hits: Array = []
	for island in ["wood", "ore", "herb"]:
		for lvl: int in [1, 2, 3]:
			var rate_sum := 0.0
			for rid in IslandEconomy.ISLANDS[island].rates:
				rate_sum = maxf(rate_sum, float(IslandEconomy.ISLANDS[island].rates[rid]) * float(lvl))
			var cap := 150.0 * float(lvl)
			var fill := Metrics.fill_seconds(cap, rate_sum)
			md.append("| %s | %d | %s | %d | %s | %s |" % [island, lvl, Metrics.fmt(rate_sum), lvl, Metrics.fmt(cap), Metrics.fmt(fill)])
	md.append("")
	md.append("Island output per extractor level is fixed (2/s × level); only storage (100 × level) bounds the idle stock. At equal extractor and storage level the fill time is constant (see table), i.e. upgrading both never changes the idle-waste window.")
	md.append("")
	# Facility sink exhaustion: all upgrades of the two Era-2 islands.
	var sink := {}
	for island in ["wood", "ore"]:
		for facility in IslandProgression.FACILITIES:
			for lvl in [1, 2]:
				var cost := IslandProgression.upgrade_cost(facility, lvl)
				for rid in cost:
					sink[rid] = float(sink.get(rid, 0.0)) + float(cost[rid])
	md.append("Total cost of every Era-2 island facility upgrade (wood+ore islands, 3 facilities × 2 upgrades): %s" % str(sink))
	var supply := {}
	for rid in ["wood", "stone_low"]:
		supply[rid] = _f(home_rates[rid])
	for rid in ["spirit_timber", "bronze_essence"]:
		var rec: Dictionary = catalog.recipes[rid]
		supply[rid] = float(rec.output) / float(IslandEconomy.DURATIONS[rid])
	var longest := 0.0
	var parts: PackedStringArray = []
	for rid in sink:
		var secs := Metrics.afford_seconds(float(sink[rid]), 0.0, float(supply.get(rid, 0.0)))
		longest = maxf(longest, secs)
		parts.append("%s %ss" % [rid, Metrics.fmt(secs)])
	md.append("")
	md.append("Serial production time per sink resource at supply rates: %s. Longest %ss." % [", ".join(parts), Metrics.fmt(longest)])
	md.append("")
	var era2_total: float = summary.chain_training_seconds.get(2, 0.0)
	summary["C10"] = {"sink_exhaust_seconds": longest, "era2_training_seconds": era2_total, "era2_gate_needs_island": era2_island_gate}
	var exhausted_share := longest / era2_total if era2_total > 0.0 else 0.0
	var sev := "OK"
	var notes: PackedStringArray = []
	if not era2_island_gate:
		sev = "WARN"
		notes.append("Era 2 level-up and breakthrough use no island/processing output (island chain is optional for Era 2 pacing)")
	if exhausted_share < 0.5:
		sev = "WARN"
		notes.append("all island facility upgrades could be done in %.0f%% of the Era-2 clock (%ss of %ss), leaving no mid-Era sink" % [exhausted_share * 100.0, Metrics.fmt(longest), Metrics.fmt(era2_total)])
	_finding("C10", sev, "; ".join(notes) if not notes.is_empty() else "island sinks outlast half of the Era 2 clock and gate on island output")

# ---------------------------------------------------------------- output
func _write_findings() -> void:
	md.append("## 6. Findings")
	md.append("")
	md.append("| ID | status | detail |")
	md.append("| --- | --- | --- |")
	for f in findings:
		md.append("| %s | %s | %s |" % [f.id, f.severity, String(f.text).replace("|", "/")])
	md.append("")

func _save() -> void:
	var file := FileAccess.open(OUT_MD, FileAccess.WRITE)
	if file == null:
		push_error("cannot write %s" % OUT_MD)
		return
	file.store_string("\n".join(md))
	file.close()
	var json := FileAccess.open(OUT_JSON, FileAccess.WRITE)
	if json != null:
