; Living abode visual prototype for 修仙問道 v2.
; Godot 4.7.2 / GDScript / Compatibility renderer.
config_version=5

[application]
run/main_scene.beast2_acceptance="res://src/verification/beast2_acceptance.tscn"

run/main_scene.sect2_acceptance="res://src/verification/sect2_acceptance.tscn"
run/main_scene.pill2_acceptance="res://src/verification/pill2_acceptance.tscn"
run/main_scene.talent2_acceptance="res://src/verification/talent2_acceptance.tscn"
run/main_scene.sks_p2_acceptance="res://src/verification/sks_p2_acceptance.tscn"
run/main_scene.content_p1_acceptance="res://src/verification/content_p1_acceptance.tscn"
run/main_scene.content_p1_story_acceptance="res://src/verification/content_p1_story_acceptance.tscn"
config/name="修仙問道 v2 — 洞府探針"
config/name.desktop_control="修仙問道 v2 — 桌面對照"
run/main_scene="res://scenes/living_abode.tscn"
run/main_scene.ui_art_edge_acceptance="res://src/verification/ui_art_edge_acceptance.tscn"
run/main_scene.content_p1_skills_acceptance="res://src/verification/content_p1_skills_acceptance.tscn"
run/main_scene.content_p1_sect_acceptance="res://src/verification/content_p1_sect_acceptance.tscn"
run/main_scene.content_p1_pills_acceptance="res://src/verification/content_p1_pills_acceptance.tscn"
run/main_scene.content_p1_talents_acceptance="res://src/verification/content_p1_talents_acceptance.tscn"
run/main_scene.ledger_acceptance="res://src/verification/ledger_acceptance.tscn"
run/main_scene.life_echo_acceptance="res://src/verification/life_echo_acceptance.tscn"
run/main_scene.life_history_acceptance="res://src/verification/life_history_acceptance.tscn"
run/main_scene.resource_accounts_acceptance="res://src/verification/resource_accounts_acceptance.tscn"
run/main_scene.decision_acceptance="res://src/verification/decision_acceptance.tscn"
run/main_scene.life_report_acceptance="res://src/verification/life_report_acceptance.tscn"
run/main_scene.trib0_acceptance="res://src/verification/trib0_acceptance.tscn"
run/main_scene.r11_acceptance="res://src/verification/uix_r11_acceptance.tscn"
run/main_scene.r10_acceptance="res://src/verification/uix_r10_acceptance.tscn"
run/main_scene.persistence_verification="res://scenes/web_persistence_probe.tscn"
run/main_scene.r6_acceptance="res://src/verification/uix_r6_acceptance.tscn"
run/main_scene.r7_acceptance="res://src/verification/uix_r7_acceptance.tscn"
run/main_scene.hud_readiness_acceptance="res://src/verification/hud_readiness_acceptance.tscn"
run/main_scene.r9_acceptance="res://src/verification/uix_r9_acceptance.tscn"
run/main_scene.r8_acceptance="res://src/verification/uix_r8_acceptance.tscn"
run/main_scene.ui_shell_acceptance="res://src/verification/ui_shell_acceptance.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.012, 0.055, 0.08, 1)
